let nextAbortId = 0;
export function setupAbort(rpcClient) {
    const abortId = nextAbortId++;
    const abortHandler = async () => {
        const res = await rpcClient.call("abort", { abortId });
        if ("error" in res)
            throw res.error;
    };
    return {
        abortId,
        abortHandler,
    };
}
